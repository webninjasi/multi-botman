[Unit]
Description=Botman journald to Discord live log agent
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
User=botman-log-agent
Group=botman-log-agent
SupplementaryGroups=systemd-journal
Environment=BOTMAN_AGENT_CONFIG=/var/lib/botman-log-agent/config.yaml
ExecStart=/opt/botman-agent/.venv/bin/botman-log-agent
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/botman-log-agent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
